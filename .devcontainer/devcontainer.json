{
  "name": "Visionary Lab Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "19"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:0": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  "postCreateCommand": "bash -c 'echo \"Installing system dependencies...\" && sudo apt update && sudo apt install -y libgl1 libglx-mesa0 && echo \"Installing Python dependencies...\" && cp .env.example .env && echo \"Installing frontend dependencies...\" && cd frontend && npm install --legacy-peer-deps'",  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "always"
        }
      }
    }
  },
  
  "remoteUser": "vscode"
}
